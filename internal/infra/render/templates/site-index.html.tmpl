<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.SiteTitle}}</title>
<link rel="stylesheet" href="style.css">
{{if .FaviconPath}}<link rel="icon" href="{{.FaviconPath}}" type="image/x-icon">{{end}}
</head>
<body class="page-shell">
<main class="content-shell">
<h1 class="page-title">Темы</h1>
<ul class="topic-list">
{{range .Topics}}<li><a href="{{.Href}}">{{.Title}}</a></li>{{end}}
</ul>
</main>
</body>
</html>
